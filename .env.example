# Root .env.example — VARIABLE NAMES ONLY. Never put real values in this file.
# Component-specific examples live in infra/.env.example and vault/.env.example.
# This file documents variables consumed by ops/ scripts on the Oracle VM.

# --- Gozunga S3-compatible backup target (ops/backup/immich-backup.sh) ---
GOZUNGA_ENDPOINT=
GOZUNGA_KEY=
GOZUNGA_SECRET=

# --- restic ---
# Path to the file holding the restic repository password.
# The password itself MUST be stored off this machine as well. See ops/README.md.
RESTIC_PASSWORD_FILE=

# --- healthchecks.io dead-man switch ---
# The UUID ONLY - not the full ping URL. The scripts prepend
# https://hc-ping.com/ themselves, so pasting the whole URL here produces
# https://hc-ping.com/https://hc-ping.com/... and every ping returns HTTP 400.
# Format: 8-4-4-4-12 hex, e.g. f1de7580-1448-4f9b-92b7-cba2b76bd4de
HEALTHCHECK_UUID=
HEALTHCHECK_METRICS_UUID=

# --- Metrics collector (ops/metrics/collect-and-push.sh) ---
# Must match METRICS_INGEST_SECRET set in the Vercel project.
METRICS_INGEST_SECRET=
METRICS_INGEST_URL=
# Dedicated read-only Immich API key: server.statistics, server.storage, server.about
IMMICH_API_KEY=
# Use the host's TAILSCALE address, e.g. http://100.x.y.z:2283 - NOT 127.0.0.1.
# docker-compose.yml binds Immich to ${TAILSCALE_IP}:2283 only, so nothing
# listens on loopback and a loopback URL makes every collector run report
# "immich api unreachable or key rejected". Find it with: tailscale ip -4
IMMICH_BASE_URL=

# --- Paths on the VM ---
UPLOAD_LOCATION=
DB_DATA_LOCATION=
