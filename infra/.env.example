# infra/.env.example — VARIABLE NAMES ONLY. Never commit real values.
#
# Copy to infra/.env on the VM and fill in. infra/.env is gitignored.
#   cp .env.example .env && chmod 600 .env

# --- Immich version -------------------------------------------------------
# Pin an explicit release. NEVER "latest" and NEVER "release".
# Check https://github.com/immich-app/immich/releases and read the breaking
# changes before bumping. Take a backup first.
IMMICH_VERSION=v3.1.0

# --- Storage paths --------------------------------------------------------
# UPLOAD_LOCATION lives on the 150 GB block volume (Lower Cost, 0 VPU).
# It holds: upload/, library/, thumbs/, encoded-video/, profile/, backups/
UPLOAD_LOCATION=/mnt/media

# DB_DATA_LOCATION lives on the 50 GB boot volume, NOT the block volume.
# Postgres wants low-latency random I/O; the block volume is provisioned for
# large sequential reads instead.
DB_DATA_LOCATION=/var/lib/immich/postgres

# --- Database credentials -------------------------------------------------
# Generate with: openssl rand -base64 32
# This value never leaves the VM. It is not needed to restore a backup, because
# restic captures the dump rather than the raw data directory.
DB_PASSWORD=
DB_USERNAME=postgres
DB_DATABASE_NAME=immich

# --- Networking -----------------------------------------------------------
# The Tailscale IPv4 address of this host: `tailscale ip -4`
# Immich binds to this address only. Binding to 0.0.0.0 would expose the
# service on the public interface and violate the no-inbound-ports rule.
TAILSCALE_IP=

# --- Timezone -------------------------------------------------------------
TZ=Asia/Kolkata
