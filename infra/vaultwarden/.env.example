# Variable NAMES only. Never put a value in this file.
#
# /opt/vaultwarden/vaultwarden.env is rendered by Ansible from
# infra/ansible/roles/vaultwarden/templates/vaultwarden.env.j2 - edit the
# template or the role defaults, never the rendered file.
#
# /opt/vaultwarden/secrets.env holds the values below. Write it ONLY with
#   sudo vw-secrets <push|admin-on|admin-off|smtp|smtp-off|show>
# (installed to /usr/local/sbin by the Ansible role, from infra/vaultwarden/vw-secrets.sh)
# which prompts without echoing, keeps the file root:root 0600, and applies the
# change. Never paste a secret on a command line: it lands in shell history.

# Push relay (plan M1). From https://bitwarden.com/host, region "United States".
PUSH_ENABLED=
PUSH_INSTALLATION_ID=
PUSH_INSTALLATION_KEY=

# Admin page. ABSENT by default, which disables /admin entirely (plan M2).
# Turned on only for a task that needs it, then off again.
ADMIN_TOKEN=

# Optional Gmail SMTP. Without it, Emergency Access requests are silent:
# see infra/vaultwarden/SECURITY-NOTES.md.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURITY=
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=
