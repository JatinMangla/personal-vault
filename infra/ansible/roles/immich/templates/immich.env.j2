# Managed by Ansible (roles/immich). Do not edit by hand - changes are
# overwritten on the next playbook run. Mode 0600: contains DB_PASSWORD.

# Pinned release. Never "latest", never "release". Bumping this is a deliberate
# act: read the release notes, take a backup, then change it here.
IMMICH_VERSION={{ immich_version }}

UPLOAD_LOCATION={{ media_mount }}
DB_DATA_LOCATION={{ db_data_location }}

DB_PASSWORD={{ immich_db_password }}
DB_USERNAME={{ immich_db_username | default('postgres') }}
DB_DATABASE_NAME={{ immich_db_name | default('immich') }}

# Immich binds to this address only, so the service is unreachable from the
# public interface even if the firewall were misconfigured.
TAILSCALE_IP={{ tailscale_ip }}

TZ={{ immich_timezone | default('Asia/Kolkata') }}
