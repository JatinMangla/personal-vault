# Managed by Ansible (roles/vaultwarden). Do not edit by hand - changes are
# overwritten on the next run. No secrets here: those live in secrets.env,
# written only by vw-secrets. Every choice is explained in
# docs/VAULTWARDEN-PLAN.md and infra/vaultwarden/SECURITY-NOTES.md.
#
# NEVER press "Save" on the /admin page. It writes /data/config.json, which
# silently overrides this file, and holds the admin token in plaintext (M2).
# The deploy and the alive check both fail while that file exists.

DOMAIN=https://{{ vaultwarden_fqdn }}
ROCKET_PORT=8080

# Family only. Nobody can register unless invited to the organisation, and only
# the owner can create an organisation.
SIGNUPS_ALLOWED=false
INVITATIONS_ALLOWED=true
ORG_CREATION_USERS={{ vaultwarden_owner_email }}

# A hint is a clue to the master password, readable before login.
PASSWORD_HINTS_ALLOWED=false
SHOW_PASSWORD_HINT=false

# No outbound fetches of website icons: removes the icon-SSRF advisory class
# and never tells anyone which sites the family uses. The TTL of 0 is what the
# template requires alongside it; otherwise cached icons expire and vanish.
DISABLE_ICON_DOWNLOAD=true
ICON_CACHE_TTL=0

SSO_ENABLED=false
EMERGENCY_ACCESS_ALLOWED=true

# Brute-force limits (M7), per client IP.
LOGIN_RATELIMIT_SECONDS=60
LOGIN_RATELIMIT_MAX_BURST=10
ADMIN_RATELIMIT_SECONDS=300
ADMIN_RATELIMIT_MAX_BURST=3
ADMIN_SESSION_LIFETIME=20

# The real client address. tailscale serve SETS (overwrites) X-Forwarded-For to
# the caller's tailnet IP (ipn/ipnlocal/serve.go, addProxyForwardedHeaders), so
# a client cannot forge it. Without this every request would come from the
# Docker gateway and the whole family would share ONE rate-limit bucket - one
# attacker could lock everyone out. "local" trusts the header only from
# non-global addresses, which is where the proxied request arrives from.
IP_HEADER=X-Forwarded-For
IP_HEADER_TRUSTED_PROXIES=local

LOG_LEVEL={{ vaultwarden_log_level }}
EXTENDED_LOGGING=true
