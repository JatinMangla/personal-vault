# vault/.env.example — VARIABLE NAMES ONLY. Never commit real values.
#
# Copy to vault/.env.local for development. Set the same names in the Vercel
# dashboard for production. vault/.env.local is gitignored.

# --- Supabase -------------------------------------------------------------
# Safe to expose to the browser: the anon key grants only what RLS policies
# allow. This is exactly why every table must have RLS enabled.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. This key BYPASSES Row Level Security entirely.
# Used solely by /api/metrics/ingest, which authenticates by HMAC rather than a
# user session. Never prefix it NEXT_PUBLIC_. Never import it into a client
# component.
SUPABASE_SERVICE_ROLE_KEY=

# --- Cloudflare R2 --------------------------------------------------------
# SERVER ONLY, all four. These must never appear in any file under app/ that
# ships to the client, and must never be prefixed NEXT_PUBLIC_.
#
# Scope the API token to ONE bucket with object read/write only.
# Never an account-level token.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=

# --- Metrics ingest (Component D) ----------------------------------------
# Shared secret for HMAC-SHA256 over the request body. Must match
# METRICS_INGEST_SECRET in /etc/personal-vault/ops.env on the Oracle VM.
# Generate with: openssl rand -hex 32
METRICS_INGEST_SECRET=
