[Unit]
Description=Push host metrics every minute
Documentation=file:///opt/personal-vault/ops/README.md

[Timer]
# Every minute. The dashboard's staleness thresholds are built around this
# interval: amber at 5 min, red at 15 min. Changing it here means changing
# vault/lib/thresholds.ts too.
#
# AccuracySec=1s is required, not cosmetic: systemd defaults to 1-minute
# accuracy, which lets it coalesce timers anywhere inside the window. On a
# 60-second timer that makes arrivals erratic - gaps of two minutes and pairs
# seconds apart - and the staleness banner would then fire on a healthy
# collector.
OnBootSec=2min
OnUnitActiveSec=1min
AccuracySec=1s

# Not Persistent: a missed metrics sample is worthless after the fact, unlike a
# missed backup. Catching up would only push stale numbers.
Unit=metrics-push.service

[Install]
WantedBy=timers.target
