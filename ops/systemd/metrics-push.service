[Unit]
Description=Collect and push host metrics to the vault dashboard
Documentation=file:///opt/personal-vault/ops/README.md
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=root
ExecStart=/opt/personal-vault/ops/metrics/collect-and-push.sh

# Must finish well inside the 1-minute interval. If it cannot, the dashboard
# staleness banner is the correct signal - not a pile of overlapping runs.
#
# The collector normally takes ~2 s. systemd will not start a second instance of
# a oneshot that is still running, so an overrun degrades to "as often as it
# can" rather than piling up.
TimeoutStartSec=60s

# Read-mostly: the collector must never mutate Immich, the database or the
# restic repository.
Nice=15
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# read-only, NOT true. The Syncthing API key lives at
# /home/ubuntu/.local/state/syncthing/config.xml, and ProtectHome=true hides it
# entirely - the sync block would then report state "unknown" forever with no
# error to explain why. Identical to the fix the restic job needed
# (docs/HARD-WON.md). Still read-only: the collector must never write to $HOME.
ProtectHome=read-only
ReadWritePaths=/var/lib/personal-vault
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
