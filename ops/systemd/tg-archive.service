[Unit]
Description=Drain the Insta360 card into Telegram (tg-archive loop)
Documentation=file:///opt/personal-vault/docs/RUNBOOK.md
# Needs the media volume mounted: staging lives under /mnt/media, and without
# this a failed volume attach would let the loop run against an empty directory
# and conclude the card was already drained.
RequiresMountsFor=/mnt/media
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ubuntu
# tg-go, not tg-archive.sh start. tg-archive drains but never touches the
# manifest, so an automatic run would hit "NOT IN MANIFEST: <file>" on every
# batch and retry forever - Check #1 correctly refusing to upload footage it
# cannot verify. tg-go fingerprints what arrived first, then drains.
#
# NOT --now. That was wrong: --now skips wait_for_sync, so update_manifest ran
# while Syncthing was still delivering, fingerprinted only what had arrived by
# then, and every later file failed Check #1 as "NOT IN MANIFEST" - the loop
# retried that same failure 21 times on the first real multi-file batch.
#
# The settle timer waits for two minutes of quiet, but a gap that long can open
# mid-transfer while the phone hashes the next file, so the timer alone is not
# proof the transfer finished. tg-go asks Syncthing directly.
ExecStart=/opt/insta360-archive/bin/tg-go.sh

# The env file is root:ubuntu 0640, NOT 0600. The service runs as ubuntu and
# could not read a root-only file - that was the first run's failure.
EnvironmentFile=/etc/personal-vault/tg-archive.env

# systemd's default PATH excludes ~/.local/bin, where pipx puts
# telegram-upload and telegram-download. Without this the loop dies on
# "telegram-upload missing" even though it runs fine in an interactive shell.
Environment=PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# A full drain is ~250 GB at roughly 1.3 MB/s from the card, and the loop also
# waits on Syncthing between batches. It is expected to run for days. Zero
# disables the timeout entirely; use 'systemctl stop tg-archive'
# to end it, not a timer.
TimeoutStartSec=0

# Deprioritised: a drain running for days must not make Immich unresponsive
# on 2 ARM cores. Immich serves photo and video requests from the same disks
# and the same two cores, so the archive always yields to it.
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=6

# Leave at least one core's worth of CPU for Immich, Postgres and the ML
# container. 2 OCPUs = 200% total, so this caps the drain at three quarters of
# one core - hashing 18 GB is CPU-bound and would otherwise compete directly
# with thumbnail generation and transcoding.
CPUQuota=75%
CPUWeight=20

# I/O weight well below the default 100. Immich reads originals and writes
# thumbnails on the same volume the drain is verifying against.
IOWeight=20

# A runaway download must not trigger the OOM killer, which on a 12 GB box
# would likely take Postgres with it rather than this.
MemoryMax=1G
MemorySwapMax=0

# The boot volume is NOT writable for bulk data. /var/lib/insta360-archive
# holds only the ledger and drain-state - a few KB - and the round trip is
# guarded in tg-upload.sh to refuse the root filesystem outright. Immich, the
# OS and Postgres share that 50 GB disk; on 2026-09-15 a verification pass took
# it from 25% to 79% before being stopped. The ReadWritePaths below is the
# whole of what this service may write.

# Hardening. The loop needs to read and delete within staging, write its state
# directory, and reach the network. Nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/insta360-archive /mnt/media/tg-staging
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
